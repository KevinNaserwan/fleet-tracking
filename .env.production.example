COMPOSE_PROJECT_NAME=fleet-tracking-prod
IMAGE_TAG=m1-YYYYMMDD
APP_ENV=production
LOG_LEVEL=info
HTTP_PORT=8080
WEB_PORT=3000
PROXY_PORT=8088
CORS_ALLOWED_ORIGINS=https://fleet.meetsin.id
TRUSTED_PROXIES=10.77.10.0/24
FLEET_API_PORT=18180
FLEET_WEB_PORT=13100
FLEET_PROMETHEUS_PORT=19090
FLEET_GRAFANA_PORT=13001

POSTGRES_DB=fleet_tracking
POSTGRES_USER=fleet
POSTGRES_PASSWORD=REPLACE_FROM_SECRET_MANAGER
# The bundled PostgreSQL service is reached only over Compose's private data network.
# For external or managed PostgreSQL, use sslmode=verify-full with its trusted CA and hostname.
DATABASE_URL=postgres://fleet:REPLACE_FROM_SECRET_MANAGER@postgres:5432/fleet_tracking?sslmode=disable
REDIS_PASSWORD=REPLACE_FROM_SECRET_MANAGER
REDIS_ADDR=redis:6379
RABBITMQ_USER=fleet
RABBITMQ_PASSWORD=REPLACE_FROM_SECRET_MANAGER
RABBITMQ_URL=amqp://fleet:REPLACE_FROM_SECRET_MANAGER@rabbitmq:5672/

JWT_ISSUER=https://fleet.meetsin.id
JWT_AUDIENCE=fleet-dashboard
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

BACKEND_URL=http://api:8080
NEXT_PUBLIC_APP_URL=https://fleet.meetsin.id
SESSION_COOKIE_SECURE=true
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_FROM_SECRET_MANAGER
