COMPOSE_PROJECT_NAME=fleet-tracking

# Application
APP_ENV=development
LOG_LEVEL=debug
HTTP_PORT=8080
WEB_PORT=3000
PROXY_PORT=8088
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12

# PostgreSQL/PostGIS
POSTGRES_DB=fleet_tracking
POSTGRES_USER=fleet
POSTGRES_PASSWORD=local-fleet-password-change-me
DATABASE_URL=postgres://fleet:local-fleet-password-change-me@postgres:5432/fleet_tracking?sslmode=disable

# Redis
REDIS_PASSWORD=local-redis-password-change-me
REDIS_ADDR=redis:6379

# RabbitMQ
RABBITMQ_USER=fleet
RABBITMQ_PASSWORD=local-rabbit-password-change-me
RABBITMQ_URL=amqp://fleet:local-rabbit-password-change-me@rabbitmq:5672/

# Authentication. Development values only; use a secret manager in production.
JWT_ISSUER=fleet-tracking
JWT_AUDIENCE=fleet-dashboard
JWT_ACCESS_SECRET=dev-only-access-secret-at-least-32-bytes-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Frontend BFF
BACKEND_URL=http://api:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_COOKIE_SECURE=false

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-password-change-me
